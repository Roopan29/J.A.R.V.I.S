# ---------------------------------------------------------------------------
# PROJECT J.A.R.V.I.S. — environment template.
# Copy to ".env" and fill in ONLY what you use.  Never commit the real .env.
#   scripts\setup_environment.bat   does the copy for you.
# ---------------------------------------------------------------------------

# Where JARVIS keeps its database, config and logs.
# Leave empty to use %APPDATA%\Jarvis on Windows (or ~/.jarvis elsewhere).
# JARVIS_HOME=

# ------------------------- AI providers ------------------------------------
# Local-first default. Install Ollama from https://ollama.com then:
#   ollama pull llama3.1        (good tool-calling model)
#   ollama pull qwen2.5:7b      (lighter alternative)
JARVIS_AI_PROVIDER=ollama
JARVIS_AI_MODEL=llama3.1
OLLAMA_HOST=http://127.0.0.1:11434

# Optional cloud provider (any OpenAI-compatible endpoint: OpenAI, Groq,
# OpenRouter, Together, LM Studio, vLLM…).  Leave the key blank to disable.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# JARVIS_CLOUD_MODEL=gpt-4o-mini

# Optional Anthropic Claude provider.
# ANTHROPIC_API_KEY=
# JARVIS_ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ------------------------- Web intelligence -------------------------------
# Brave Search API key is optional; without it JARVIS uses DuckDuckGo HTML.
# BRAVE_SEARCH_API_KEY=

# ------------------------- Voice ------------------------------------------
# Piper voice model (downloaded by scripts\install.bat on request).
JARVIS_PIPER_VOICE=en_US-lessac-medium
# faster-whisper model size: tiny | base | small | medium | large-v3
JARVIS_WHISPER_MODEL=base

# ------------------------- Security ---------------------------------------
# Extra applications JARVIS may launch without asking (semicolon separated).
# JARVIS_APP_ALLOWLIST=notepad.exe;calc.exe
